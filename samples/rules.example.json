{
  "version": 1,
  "rules": [
    {
      "id": "personal-vault",
      "mode": "hidden",
      "note": "个人敏感资料库：DSH 触碰时一律伪装成“不存在”（目录整树 + 单文件混用）",
      "paths": [
        "C:\\Users\\dell\\secret-box",
        "D:\\keys\\id_ed25519"
      ]
    },
    {
      "id": "project-secrets",
      "mode": "hidden",
      "note": "仓库里的凭据：** 表示任意层目录，于是仓库根与深层子目录的 .env 一起被圈住",
      "paths": [
        "C:\\work\\repo\\.env",
        "C:\\work\\repo\\**\\.env",
        "C:\\work\\repo\\credentials\\**"
      ],
      "tools": ["read", "read_image", "write", "edit", "glob", "grep", "bash", "pwsh"]
    },
    {
      "id": "archive-readonly",
      "mode": "deny",
      "note": "归档只读：拒绝写入/编辑（deny 模式会明确点名规则），但读取不受影响",
      "paths": [
        "D:\\archive\\**"
      ],
      "tools": ["write", "edit", "str_replace_editor", "bash", "pwsh"]
    },
    {
      "id": "keys-ask",
      "mode": "ask",
      "note": "v0.4 人在回路：命中后先弹出确认框（路径 + 规则 + 工具 + 风险）。minRisk=medium 表示只读访问不打扰我、写入/执行才问；remember + borrowTtlMs 表示同意一次后这条路径 10 分钟内不再重复询问（同目录其它文件仍会问，要授权整棵目录用 /wall borrow add D:\\keys）。",
      "paths": [
        "D:\\keys"
      ],
      "minRisk": "medium",
      "remember": true,
      "borrowTtlMs": 600000
    },
    {
      "id": "wallet-write-only",
      "mode": "ask",
      "note": "只要写：任何写入/执行都要我点头，且不记借出（remember=false → 每次触碰都单独确认）",
      "paths": [
        "C:\\Users\\dell\\wallet"
      ],
      "minRisk": "medium",
      "remember": false,
      "tools": ["write", "edit", "str_replace_editor", "bash", "pwsh", "run_code", "cordis_define"]
    }
  ]
}
