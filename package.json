{
  "name": "dsh-vault-wall",
  "version": "0.3.0",
  "description": "保险区 Vault Wall — 让 DeepSeek Harness 无法感知、无法触碰用户指定敏感路径的隔离墙插件（隔离墙 + 临时借出 + 触碰审计 + 紧急熔断）",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lxwallac/dsh-vault-wall.git"
  },
  "homepage": "https://github.com/lxwallac/dsh-vault-wall",
  "bugs": {
    "url": "https://github.com/lxwallac/dsh-vault-wall/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "privacy",
    "security",
    "vault"
  ],
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./client": "./browser/client.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src/**",
    "browser/**",
    "samples/**",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test": "node --test tests/rules.test.js tests/classify.test.js tests/borrow.test.js tests/audit.test.js tests/audit-file.test.js tests/wall-core.test.js tests/doc-bridge.test.js tests/console.test.js tests/client-bundle.test.js tests/index-wiring.test.js"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc.1 <0.1.0 || >=0.1.0-rc.1 <0.2.0-0",
    "@deepseek-ai/schemastery": "^3.0.0"
  }
}
